<div class="p-6">
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-bold text-black">Aprovação e Vales (Motoristas)</h2>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nome</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Chave PIX</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vales Acumulados</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Ações</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        {{#each this.model as |driver|}}
          <tr>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="font-medium text-gray-900">{{driver.name}}</div>
              <div class="text-sm text-gray-500">{{driver.phone}}</div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              {{#if driver.meta.pix_key}}
                <span class="text-sm text-gray-900">{{driver.meta.pix_key}}</span>
                <span class="text-xs text-gray-500 block">({{driver.meta.pix_key_type}})</span>
              {{else}}
                <span class="text-sm text-red-500 italic">Não informada</span>
              {{/if}}
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="text-sm font-bold text-red-600">
                R$ {{if driver.meta.vales driver.meta.vales "0.00"}}
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              {{#if (eq driver.status "pending")}}
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                  Em Análise
                </span>
              {{else}}
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                  Ativo
                </span>
              {{/if}}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              
              {{!-- Botão Lançar Vale: Abre modal/prompt que injeta valor no meta.vales via PATCH API --}}
              <button 
                type="button" 
                class="text-gray-600 hover:text-black bg-gray-100 px-3 py-1 rounded mr-2"
                {{on "click" (fn this.openValeModal driver)}}
              >
                Lançar Vale
              </button>

              {{!-- Botão Aprovar: Dispara o Webhook atualizando status para 'active' --}}
              {{#if (eq driver.status "pending")}}
                <button 
                  type="button" 
                  class="text-white bg-red-600 hover:bg-red-700 px-4 py-1 rounded shadow-sm"
                  {{on "click" (fn this.approveDriver driver)}}
                >
                  Aprovar
                </button>
              {{/if}}

            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
