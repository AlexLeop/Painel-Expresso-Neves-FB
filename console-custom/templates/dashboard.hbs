<div class="dashboard-wrapper p-8 animate-fade-in">
  
  <!-- Header Section -->
  <div class="flex justify-between items-end mb-8">
    <div>
      <h1 class="text-3xl font-extrabold text-white mb-1">Painel de Operações</h1>
      <p class="text-secondary text-sm">Bem-vindo ao centro de comando, <span class="text-red-500 font-bold">Expresso Neves</span></p>
    </div>
    <div class="flex gap-3">
        <button class="btn-primary-red shadow-lg">+ Nova Entrega</button>
    </div>
  </div>

  <!-- 4 Summary Cards (Basado na imagem de referência) -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    
    <div class="custom-card p-6 relative overflow-hidden">
      <div class="z-10 relative">
        <span class="text-gray-400 text-xs font-semibold uppercase tracking-wider">Faturamento Total</span>
        <h2 class="text-3xl font-bold text-white mt-1">R$ {{model.weeklyEarnings}}</h2>
        <div class="mt-2 text-green-500 text-xs font-bold">↑ 12% vs última semana</div>
      </div>
      <div class="absolute -right-4 -bottom-4 opacity-10">
        <svg width="100" height="100" fill="white"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.68-.93 2.25z"/></svg>
      </div>
    </div>

    <div class="custom-card p-6 border-l-4 border-red-600">
      <span class="text-gray-400 text-xs font-semibold uppercase tracking-wider">Ativas Agora</span>
      <h2 class="text-3xl font-bold text-white mt-1">{{model.activeOrdersCount}}</h2>
      <div class="flex items-center gap-2 mt-2">
         <span class="flex h-2 w-2 rounded-full bg-red-500 animate-pulse"></span>
         <span class="text-red-500 text-xs uppercase">Live</span>
      </div>
    </div>

    <div class="custom-card p-6">
      <span class="text-gray-400 text-xs font-semibold uppercase tracking-wider">Finalizadas</span>
      <h2 class="text-3xl font-bold text-white mt-1">{{model.completedOrdersCount}}</h2>
      <p class="text-gray-500 text-xs mt-2">Volume semanal: 248</p>
    </div>

    <div class="custom-card p-6 bg-gradient-to-br from-red-900/20 to-black">
      <span class="text-gray-400 text-xs font-semibold uppercase tracking-wider">Ganhos Motoboys</span>
      <h2 class="text-3xl font-bold text-white mt-1">R$ {{model.driverEarnings}}</h2>
      <p class="text-gray-500 text-xs mt-2 text-red-400/60 font-mono italic">Efficiency Rate: 98%</p>
    </div>

  </div>

  <div class="grid grid-cols-12 gap-8">
    
    <!-- Lado Esquerdo: Motoboys (33% width) -->
    <div class="col-span-12 lg:col-span-4 flex flex-col gap-4">
       <div class="flex justify-between items-center px-2">
          <h3 class="text-white font-bold tracking-tight uppercase text-sm italic">Motoboys em Rota</h3>
          <span class="text-xs text-red-500 font-mono">Total: {{model.activeDrivers.length}}</span>
       </div>

       <div class="space-y-3 overflow-y-auto pr-2" style="max-height: 600px;">
         {{#each model.activeDrivers as |driver|}}
            <div class="custom-card p-4 flex items-center justify-between border-l-2 border-transparent hover:border-red-600">
               <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center text-red-500 font-bold">
                    {{substring driver.name 0 1}}
                  </div>
                  <div>
                    <p class="text-sm font-bold text-white leading-none">{{driver.name}}</p>
                    <p class="text-xs text-gray-500 mt-1 uppercase">{{driver.vehicle_type}} • {{driver.phone}}</p>
                  </div>
               </div>
               <div class="text-right">
                  <p class="text-xs font-bold text-red-500">R$ {{driver.current_run_value}}</p>
                  <span class="text-[10px] bg-red-500/10 text-red-500 px-2 py-0.5 rounded uppercase font-bold">Produzindo</span>
               </div>
            </div>
         {{/each}}
       </div>
    </div>

    <!-- Lado Direito: Mapa (66% width) -->
    <div class="col-span-12 lg:col-span-8">
       <div class="custom-card overflow-hidden h-[650px] relative shadow-2xl">
          <div class="absolute top-4 right-4 z-[1000] flex flex-col gap-2">
             <button class="p-2 bg-black/80 border border-zinc-800 rounded text-white hover:bg-red-600 transition-colors">
                <i class="fa fa-layer-group"></i>
             </button>
          </div>
          {{fleet-map 
            data=model.locations 
            darkTheme=true 
            accentColor="#EE0000"
            class="w-full h-full"
          }}
       </div>
    </div>

  </div>
</div>
